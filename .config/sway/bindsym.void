# Special keys to adjust volume via PulseAudio
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5% && pactl get-sink-volume @DEFAULT_SINK@ | awk 'NR==1{print substr($5,1,length($5)-1)}' > $wobpipe
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5% && pactl get-sink-volume @DEFAULT_SINK@ | awk 'NR==1{print substr($5,1,length($5)-1)}' > $wobpipe
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle && ( [ "$(pactl get-sink-mute @DEFAULT_SINK@)" = "Mute: yes" ] && echo 0 > $wobpipe ) || pactl get-sink-volume @DEFAULT_SINK@ | awk 'NR==1{print substr($5,1,length($5)-1)}' > $wobpipe
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle

# Special keys to adjust irightness via brightnessctl
bindsym --locked XF86MonBrightnessDown exec brightnessctl | sed -En 's/.*\(([0-9]+)%\).*/\1/p' > $wobpipe
bindsym --locked XF86MonBrightnessUp exec brightnessctl | sed -En 's/.*\(([0-9]+)%\).*/\1/p' > $wobpipe

# Special key to take a screenshot with grim
bindsym Print exec grim